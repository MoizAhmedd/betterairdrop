# TODO(M12): DRAFT. Not enabled (it isn't in .github/workflows). See docs/release/README.md.
name: release
on:
  push:
    tags: ["v*"]

jobs:
  build:
    runs-on: macos-15
    environment: release          # add required reviewers to this environment
    steps:
      - uses: actions/checkout@v4

      - name: Import the signing certificate into a temporary keychain
        env:
          P12: ${{ secrets.SIGNING_P12_BASE64 }}
          P12_PASSWORD: ${{ secrets.SIGNING_P12_PASSWORD }}
        run: |
          KC="$RUNNER_TEMP/release.keychain-db"; PASS=$(openssl rand -hex 16)
          security create-keychain -p "$PASS" "$KC"
          security set-keychain-settings "$KC"
          security unlock-keychain -p "$PASS" "$KC"
          echo "$P12" | base64 --decode > "$RUNNER_TEMP/id.p12"
          security import "$RUNNER_TEMP/id.p12" -k "$KC" -P "$P12_PASSWORD" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple: -s -k "$PASS" "$KC"
          security list-keychains -d user -s "$KC" $(security list-keychains -d user | tr -d '"')
          rm "$RUNNER_TEMP/id.p12"
          echo "IDENTITY=$(security find-identity -p codesigning "$KC" | awk 'NR==2{print $2}')" >> "$GITHUB_ENV"

      - name: Build, sign, zip
        env:
          SPARKLE_FEED_URL: ${{ vars.SPARKLE_FEED_URL }}
          SPARKLE_PUBLIC_KEY: ${{ vars.SPARKLE_PUBLIC_KEY }}
        run: |
          V="${GITHUB_REF_NAME#v}"
          scripts/make-app.sh --universal --sign "$IDENTITY" --version "$V" --build "$GITHUB_RUN_NUMBER" --out dist
          (cd dist && ditto -c -k --keepParent BetterAirdrop.app BetterAirdrop.zip && shasum -a 256 BetterAirdrop.zip > SHA256SUMS)

      # TODO(M12): Sparkle generate_appcast with SPARKLE_ED_PRIVATE_KEY, upload the zip and
      # SHA256SUMS to the GitHub release, and publish appcast.xml + install.sh to Pages.
